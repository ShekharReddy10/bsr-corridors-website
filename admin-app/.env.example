# Copy to .env for local development. In production set these in Render → Environment.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase → Project settings → Database → Connection string (Session pooler, port 5432)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP A COPY SOMEWHERE SAFE — without it, ID numbers and JSON backups cannot be decrypted.
FIELD_ENCRYPTION_KEY=
# Random string; also saved as a GitHub Actions secret for the nightly backup
BACKUP_TOKEN=
BACKUP_KEEP_DAYS=30
# The single admin login (created/updated on every deploy)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Google Drive (owner's Gmail) — see README "Google Drive setup"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_EMAIL=bsrcorridors@gmail.com
GDRIVE_ROOT_FOLDER=BSR Corridors Admin
HOTEL_NAME=BSR Corridors
