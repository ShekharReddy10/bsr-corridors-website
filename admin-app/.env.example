# Copy to .env for local development. In production set these in Render → Environment.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase → Project settings → Database → Connection string (Session pooler, port 5432)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP A COPY SOMEWHERE SAFE — without it, ID numbers and JSON backups cannot be decrypted.
FIELD_ENCRYPTION_KEY=
# Random string; also saved as a GitHub Actions secret for the nightly backup
BACKUP_TOKEN=
BACKUP_KEEP_DAYS=30
# The single admin login (created/updated on every deploy)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Google Drive (owner's Gmail) — see README "Google Drive setup"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_EMAIL=bsrcorridors@gmail.com
GDRIVE_ROOT_FOLDER=BSR Corridors Admin
HOTEL_NAME=BSR Corridors
# Payment links: UPI ID that receives guest payments (e.g. a business UPI ID), and the payee name shown in UPI apps
UPI_ID=
UPI_NAME=BSR Corridors
# Short links for guests start with this address (the website forwards /s/* to this app); empty = this app's address
SHORT_LINK_BASE=

# BSR Group of Hotels (cluster)
CLUSTER_NAME=BSR Group of Hotels
# Database size limit shown on the cluster home page (Supabase free plan: 500)
DB_LIMIT_MB=500
# Other cluster items connect their own Google Drive by signing in on the web: a "Web application" OAuth client in
# the same Google Cloud project, redirect URI https://<admin app>/properties/drive/callback/
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
